// RAW BREAK - venue surfaces: the Age / wear stack of venue-dive-bar 6.2 and the procedural patterns of the dive-bar masters
// (M_DB_Opaque, M_DB_Coated, M_DB_Metal, M_DB_Vinyl, M_DB_Glass, M_DB_Emissive, M_DB_Floor, M_DB_Decal; generated by
// Tools/unreal/editor/rb_make_divebar_materials.py, Docs/ue-architecture.md 18.8). Included by the Custom nodes of those
// masters as /RawBreak/Private/Venue/RbVenueWear.ush. The Substrate topology (slabs, clear coat, fuzz, translucency) lives in
// the generated graphs; this file holds the maths.
//
// Self-contained on purpose (own hash / noise helpers with the RbV prefix): the table package owns Shaders/Private/*.ush and the
// venue must not break when those change. Units: world positions in cm (Unreal), pattern coordinates in metres.
// Ray tracing: ddx / ddy are 0 in hit shaders (Lumen hit-lit reflections), so every footprint has a floor (RBV_RT_FOOTPRINT).
//
// Wear mask T_DB_<Asset>_WM (UV1, baked by Tools/blender/divebar/db_props_common.py): R convexity (edge band), G ambient
// occlusion, B authored touch mask, A height above the floor normalised per asset.
// Owner: M2-B.

#pragma once

#define RBV_PI 3.14159265358979

#if RAYHITGROUPSHADER || RAYMISSSHADER || RAYCALLABLESHADER
	#define RBV_RAY_TRACING 1
#else
	#define RBV_RAY_TRACING 0
#endif

// ---- hashing / noise ------------------------------------------------------------------------------------------------

uint RbVPcg(uint V)
{
	const uint State = V * 747796405u + 2891336453u;
	const uint Word = ((State >> ((State >> 28u) + 4u)) ^ State) * 277803737u;
	return (Word >> 22u) ^ Word;
}

float RbVHash2(int2 C)
{
	return float(RbVPcg(asuint(C.x) + RbVPcg(asuint(C.y) + 0x9E3779B9u))) * (1.0 / 4294967296.0);
}

float RbVHash3(int3 C)
{
	return float(RbVPcg(asuint(C.x) + RbVPcg(asuint(C.y) + RbVPcg(asuint(C.z) + 0x7F4A7C15u)))) * (1.0 / 4294967296.0);
}

float2 RbVHash22(int2 C)
{
	const uint H = RbVPcg(asuint(C.x) * 1664525u + RbVPcg(asuint(C.y) + 0x2545F491u));
	return float2(float(H & 0xFFFFu), float(H >> 16u)) * (1.0 / 65536.0);
}

// 2D value noise (smooth), ~[0, 1].
float RbVNoise2(float2 P)
{
	const float2 I = floor(P);
	const float2 F = P - I;
	const float2 U = F * F * (3.0 - 2.0 * F);
	const int2 C = int2(I);
	const float A = RbVHash2(C);
	const float B = RbVHash2(C + int2(1, 0));
	const float Cc = RbVHash2(C + int2(0, 1));
	const float D = RbVHash2(C + int2(1, 1));
	return lerp(lerp(A, B, U.x), lerp(Cc, D, U.x), U.y);
}

// 3D value noise, ~[0, 1].
float RbVNoise3(float3 P)
{
	const float3 I = floor(P);
	const float3 F = P - I;
	const float3 U = F * F * (3.0 - 2.0 * F);
	const int3 C = int3(I);
	const float A0 = lerp(RbVHash3(C), RbVHash3(C + int3(1, 0, 0)), U.x);
	const float A1 = lerp(RbVHash3(C + int3(0, 1, 0)), RbVHash3(C + int3(1, 1, 0)), U.x);
	const float B0 = lerp(RbVHash3(C + int3(0, 0, 1)), RbVHash3(C + int3(1, 0, 1)), U.x);
	const float B1 = lerp(RbVHash3(C + int3(0, 1, 1)), RbVHash3(C + int3(1, 1, 1)), U.x);
	return lerp(lerp(A0, A1, U.y), lerp(B0, B1, U.y), U.z);
}

// Octave weight for a pattern frequency Freq [1/unit] at a pixel footprint [unit]: fades before Nyquist (no shimmer).
float RbVOctave(float Freq, float Footprint)
{
	return 1.0 - smoothstep(0.25, 0.5, Freq * Footprint);
}

float RbVFootprint3(float3 P)
{
	const float3 W = fwidth(P);
	const float F = max(W.x, max(W.y, W.z));
#if RBV_RAY_TRACING
	return max(F, 0.01);
#else
	return F;
#endif
}

float RbVFootprint2(float2 P)
{
	const float2 W = fwidth(P);
	const float F = max(W.x, W.y);
#if RBV_RAY_TRACING
	return max(F, 0.01);
#else
	return F;
#endif
}

// Band-limited fbm of 3D value noise (0..1, mean 0.5).
float RbVFbm3(float3 P, int Octaves, float Footprint)
{
	float Sum = 0.0;
	float Norm = 0.0;
	float Amp = 0.5;
	float Freq = 1.0;
	for (int K = 0; K < Octaves; ++K)
	{
		const float W = RbVOctave(Freq, Footprint);
		Sum += Amp * lerp(0.5, RbVNoise3(P * Freq + float3(13.1 * K, -7.3 * K, 3.7 * K)), W);
		Norm += Amp;
		Freq *= 2.0;
		Amp *= 0.5;
	}
	return Sum / max(Norm, 1e-4);
}

float RbVFbm2(float2 P, int Octaves, float Footprint)
{
	float Sum = 0.0;
	float Norm = 0.0;
	float Amp = 0.5;
	float Freq = 1.0;
	for (int K = 0; K < Octaves; ++K)
	{
		const float W = RbVOctave(Freq, Footprint);
		Sum += Amp * lerp(0.5, RbVNoise2(P * Freq + float2(13.1 * K, -7.3 * K)), W);
		Norm += Amp;
		Freq *= 2.0;
		Amp *= 0.5;
	}
	return Sum / max(Norm, 1e-4);
}

float RbVLuminance(float3 C)
{
	return dot(C, float3(0.2126, 0.7152, 0.0722));
}

float3 RbVDesaturate(float3 C, float Amount)
{
	return lerp(C, RbVLuminance(C).xxx, saturate(Amount));
}

// ---- the Age / wear stack (venue-dive-bar 6.2) ----------------------------------------------------------------------
//
// Inputs: the surface before wear (Albedo, Roughness), the substrate revealed by edge wear (UnderAlbedo, UnderRoughness), the
// wear mask WM, world position [cm] and normal, two tiling break-up masks (Grunge = N_grunge, Scuff = N_scuff, 0..1), the
// venue MPC values (Age, GrimeTint, DustColor, NicotineTint) and the per-instance controls (AgeBias, EdgeWearWidth,
// TouchPolish 0/1, DustK = k_d, Nicotine amount). Outputs: albedo, roughness, Reveal (edge wear 0..1), Dust (fuzz 0..1),
// Polish (touch polish 0..1, a coat is worn through where it exceeds 0.6).
float3 RbVenueWear(float3 Albedo, float Roughness, float3 UnderAlbedo, float UnderRoughness, float4 WM, float3 WorldPosCm, float3 WorldN,
	float Grunge, float Scuff, float Age, float AgeBias, float EdgeWearWidth, float TouchPolish, float DustK, float Nicotine,
	float3 GrimeTint, float3 DustColor, float3 NicotineTint,
	out float OutRoughness, out float OutReveal, out float OutDust, out float OutPolish)
{
	const float A = saturate(Age + AgeBias);
	const float Conv = saturate(WM.r * EdgeWearWidth);
	const float AO = WM.g;
	const float Touch = WM.b;
	const float3 Pm = WorldPosCm * 0.01;
	const float Fp = RbVFootprint3(Pm);
	const float Local = RbVFbm3(Pm * 11.0, 3, Fp * 11.0);

	// edge wear: reveals the substrate where convexity x grunge exceeds an Age threshold
	const float Te = 1.0 - 0.42 * A * (1.0 + AgeBias);
	const float EdgeSignal = Conv * (0.45 + 0.9 * Grunge) * (0.8 + 0.4 * Local);
	const float Reveal = smoothstep(Te - 0.06, Te + 0.06, EdgeSignal);
	float3 C = lerp(Albedo, UnderAlbedo, Reveal);
	float R = lerp(Roughness, UnderRoughness, Reveal);

	// cavity grime
	const float G = A * pow(saturate(1.0 - AO), 1.5) * 0.8 * (0.7 + 0.6 * Grunge);
	C = lerp(C, C * 0.35 + GrimeTint * 0.65, saturate(0.75 * G));
	R += 0.2 * G;

	// kick grime (0 - 30 cm above the floor)
	const float Kick = A * saturate(1.0 - WorldPosCm.z / 30.0) * saturate(Scuff * 1.4) * (0.6 + 0.4 * Local);
	C = lerp(C, GrimeTint * 0.8, 0.55 * Kick);
	R += 0.12 * Kick;

	// touch polish (hand oils: darker, glossier)
	const float P = Touch * A * TouchPolish;
	R -= 0.15 * P;
	C *= 1.0 - 0.15 * P;

	// dust on upward faces that nobody touches
	const float Up = saturate((WorldN.z - 0.6) / 0.4);
	const float D = saturate(A * DustK * Up * (1.0 - Touch) * (0.55 + 0.9 * Grunge));
	C = lerp(C, DustColor, 0.7 * D);
	R = lerp(R, 0.9, D);

	// nicotine
	const float N = saturate(A * Nicotine * (0.75 + 0.5 * Local));
	C *= lerp(float3(1.0, 1.0, 1.0), NicotineTint, N);

	OutRoughness = saturate(R);
	OutReveal = Reveal;
	OutDust = D;
	OutPolish = P;
	return saturate(C);
}

// ---- base colour helpers --------------------------------------------------------------------------------------------

// Texture colour x tint with optional desaturation (recolouring a CC0 scan: the scan keeps its pattern, the tint sets the paint).
// Strength 0 = the tint alone, 1 = texture x tint; Recolor 1 = the texture's luminance (relative to its mean) x tint.
float3 RbVBaseColor(float3 Tex, float3 Tint, float Strength, float Recolor, float TexMeanLum)
{
	const float L = RbVLuminance(Tex) / max(TexMeanLum, 1e-3);
	const float3 Recolored = Tint * L;
	const float3 Multiplied = Tex * Tint;
	return lerp(Tint, lerp(Multiplied, Recolored, saturate(Recolor)), saturate(Strength));
}

// ---- procedural patterns (PatternMode of M_DB_Opaque / M_DB_Coated) --------------------------------------------------

// 1970s grooved plywood paneling: random-width faux planks (V-grooves every 5-20 cm along the horizontal U), plank-to-plank
// tone. Returns (albedo multiplier, groove depth 0..1 (cavity), plank tone 0..1, groove normal x). U, V in metres.
float4 RbVPanelGrooves(float2 UV, float Footprint)
{
	// plank boundaries: cumulative random widths in 25 cm blocks -> 1-3 grooves per block
	const float Block = floor(UV.x / 0.25);
	const float Hb = RbVHash2(int2(int(Block), 71));
	const float Local = UV.x / 0.25 - Block;                       // 0..1 inside the block
	const float Split1 = 0.25 + 0.5 * Hb;
	const float Two = step(0.5, RbVHash2(int2(int(Block), 13)));
	const float Split2 = lerp(2.0, 0.55 + 0.4 * RbVHash2(int2(int(Block), 29)), Two);
	float Dist = min(Local, 1.0 - Local);                            // to the block edges (always a groove)
	Dist = min(Dist, abs(Local - Split1));
	Dist = min(Dist, abs(Local - Split2));
	const float DistM = Dist * 0.25;
	const float HalfW = 0.0022;                                      // groove half width 2.2 mm
	const float Aa = max(Footprint, 1e-4);
	const float Groove = 1.0 - smoothstep(HalfW - Aa, HalfW + Aa, DistM);
	const float PlankId = Block * 3.0 + step(Split1, Local) + step(Split2, Local);
	const float Tone = RbVHash2(int2(int(PlankId), 5));
	const float Side = (Local < Split1) ? -1.0 : 1.0;
	return float4(lerp(1.0, 0.35, Groove), Groove, Tone, Groove * Side * 0.35);
}

// Mineral-fibre ceiling tile "fissured" surface: small dark worm-like pits. P in metres (tile plane). Returns (albedo mult, pit).
float2 RbVCeilingFissures(float2 P, float Footprint)
{
	const float F1 = RbVNoise2(P * 180.0);
	const float F2 = RbVNoise2(P * 420.0 + 7.3);
	const float Worm = saturate((abs(F1 - 0.5) < 0.035 ? 1.0 : 0.0) * RbVOctave(180.0, Footprint));
	const float Pits = saturate((F2 > 0.86 ? 1.0 : 0.0) * RbVOctave(420.0, Footprint));
	const float Pit = saturate(Worm * 0.8 + Pits);
	const float Mottle = RbVFbm2(P * 6.0, 3, Footprint * 6.0);
	return float2((1.0 - 0.45 * Pit) * (0.94 + 0.12 * Mottle), Pit);
}

// Per-tile variation of the 2 x 4 ft lay-in tiles (0.6096 x 1.2192 m, long side along X, grid from the venue origin; venue-dive-bar
// 2.2, 9.2): no two tiles age alike. Pm = world position in metres. Returns (brightness multiplier, extra nicotine 0..1, water-stain
// darkening 0..1): a third of the tiles yellower, about one in nine with a brown leak ring (a soft blotch with a darker tide line).
float3 RbVCeilingTile(float3 Pm)
{
	const float2 Size = float2(1.2192, 0.6096);
	const float2 Cell = floor(Pm.xy / Size);
	const float2 F = Pm.xy / Size - Cell;
	const float H = RbVHash2(int2(Cell) + int2(17, 5));
	const float H2 = RbVHash2(int2(Cell) + int2(3, 91));
	const float Bright = 0.88 + 0.18 * H2;
	const float Nic = saturate((H2 - 0.55) * 1.8);
	float Stain = 0.0;
	if (H > 0.89)
	{
		const float2 C = float2(0.3 + 0.4 * frac(H * 13.1), 0.3 + 0.4 * frac(H * 7.7));
		const float2 D = (F - C) * Size;
		const float R = length(D) / (0.10 + 0.14 * frac(H * 3.3));
		const float Wob = R * (1.0 + 0.14 * sin(atan2(D.y, D.x) * 5.0 + H * 20.0) + 0.06 * sin(atan2(D.y, D.x) * 11.0 + H * 7.0));
		Stain = saturate(1.0 - Wob) * 0.3 + exp(-pow((Wob - 1.0) / 0.07, 2.0)) * 0.55 + exp(-pow((Wob - 0.62) / 0.05, 2.0)) * 0.25;
	}
	return float3(Bright, Nic, saturate(Stain));
}

// ---- stains (texture bombing of the decal atlases on horizontal faces; rings, burns) ---------------------------------
//
// P: object-space position in metres on the surface plane; one stain candidate per CellM cell, placed inside the cell so it never
// crosses the cell border. Atlas: 4 x 4 cells (BC.rgb colour, BC.a coverage). Returns (colour, coverage) of the strongest stain.
float4 RbVStainBomb(float2 P, float CellM, float Density, float Seed, float SizeM, float CellFirst, float CellCount,
	Texture2D Atlas, SamplerState AtlasSampler)
{
	// gradients first (uniform control flow), scaled into atlas space below
	const float2 Dx = ddx(P);
	const float2 Dy = ddy(P);
	const float2 Cell = floor(P / CellM);
	const int2 Ci = int2(Cell) + int2(int(Seed * 131.0), int(Seed * 71.0));
	const float H = RbVHash2(Ci);
	if (H > Density)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	const float2 Rnd = RbVHash22(Ci + int2(17, 3));
	const float Scale = SizeM * (0.8 + 0.4 * RbVHash2(Ci + int2(5, 9)));
	const float Margin = 0.5 * Scale / CellM;
	const float2 Center = (Cell + lerp(Margin.xx, (1.0 - Margin).xx, Rnd)) * CellM;
	const float Ang = RbVHash2(Ci + int2(41, 7)) * 2.0 * RBV_PI;
	const float2 D = (P - Center) / Scale;                          // -0.5..0.5 inside the stain
	const float2 Rot = float2(cos(Ang) * D.x - sin(Ang) * D.y, sin(Ang) * D.x + cos(Ang) * D.y);
	if (any(abs(Rot) > 0.5))
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	const float Index = CellFirst + floor(RbVHash2(Ci + int2(23, 61)) * CellCount);
	const float2 CellUV = float2(fmod(Index, 4.0), floor(Index / 4.0));
	const float2 UV = (CellUV + Rot + 0.5) / 4.0;
	return Atlas.SampleGrad(AtlasSampler, UV, Dx / (Scale * 4.0), Dy / (Scale * 4.0));
}

// ---- VCT floor (venue-dive-bar H11, 6.3, R1) ---------------------------------------------------------------------------
//
// P: world XY in metres (room frame V: the tile grid starts at the inside corner of the front and the left wall). Tiles 305 mm,
// checker of ColorA / ColorB, per-tile colour +-4 %, roughness +-0.05, a replaced patch (PatchRect, PatchColor), beige tiles
// beyond CorridorX. Masks (a baked 2K mask over the room): R traffic lanes (dull wax), G dried beer (sticky), B fresh spills,
// A chalk dust. Micro: the linoleum scan's normal / roughness. Returns albedo; outputs roughness and a seam normal.
float3 RbVctFloor(float2 P, float3 ColorA, float3 ColorB, float3 PatchColor, float4 PatchRect, float CorridorX, float3 CorridorColor,
	float4 Masks, float MicroRough, float Age, float StickyAmount, float3 GrimeTint, float3 ChalkColor,
	out float OutRoughness, out float3 OutNormalTS)
{
	const float Tile = 0.3048;
	const float2 T = P / Tile;
	const float2 Ti = floor(T);
	const float2 F = T - Ti;
	const int2 Id = int2(Ti);
	const float H = RbVHash2(Id + int2(311, 97));
	const float Checker = fmod(abs(Ti.x + Ti.y), 2.0);
	float3 C = lerp(ColorA, ColorB, Checker);
	const float2 Pc = (Ti + 0.5) * Tile;
	if (all(Pc > PatchRect.xy) && all(Pc < PatchRect.zw))
	{
		C = lerp(PatchColor, ColorB, Checker);
	}
	if (Pc.x > CorridorX)
	{
		C = CorridorColor * lerp(0.97, 1.0, Checker);
	}
	C *= 0.92 + 0.16 * H;
	// VCT has a mottled chip pattern
	const float Fp = RbVFootprint2(P);
	const float Chips = RbVFbm2(P * 60.0 + H * 17.0, 3, Fp * 60.0);
	C *= 0.86 + 0.28 * Chips;
	// sixty years of wax and mop water: faded, desaturated colours, a grey film that sits in the low spots
	const float Film = RbVFbm2(P * 1.3 + 3.1, 4, Fp * 1.3);
	C = lerp(C, RbVLuminance(C).xxx, 0.25 * Age);
	C = lerp(C, C * 0.62 + GrimeTint * 0.55, saturate(Age * (0.25 + 0.5 * Film)));
	// heel marks and scuffs: short dark streaks, mostly along the walking directions
	const float Heel = saturate((RbVFbm2(float2(P.x * 2.5, P.y * 14.0) + H * 3.0, 3, Fp * 14.0) - 0.60) * 5.0)
		+ saturate((RbVFbm2(float2(P.x * 14.0, P.y * 2.5) + 9.0, 3, Fp * 14.0) - 0.63) * 5.0);
	C = lerp(C, float3(0.012, 0.011, 0.010), saturate(Heel) * 0.55 * Age);

	// seams: tight butt joints, ~0.6 mm dark line with a slight bevel (worn tile edges)
	const float2 Edge = min(F, 1.0 - F) * Tile;
	const float EdgeD = min(Edge.x, Edge.y);
	const float Aa = max(Fp, 2e-4);
	const float Seam = 1.0 - smoothstep(0.0003 - Aa, 0.0003 + Aa, EdgeD);
	const float Bevel = 1.0 - smoothstep(0.0, 0.0025 + Aa, EdgeD);
	const float2 Dir = float2(F.x < 0.5 ? -1.0 : 1.0, F.y < 0.5 ? -1.0 : 1.0) * float2(Edge.x < Edge.y ? 1.0 : 0.0, Edge.x < Edge.y ? 0.0 : 1.0);
	OutNormalTS = normalize(float3(Dir * Bevel * 0.35, 1.0));
	C = lerp(C, GrimeTint * 0.5, saturate(Seam * 0.85 + Bevel * 0.25 * Age));

	// wax: glossy where nobody walks (walls, under booths), dull in the lanes; tile-to-tile roughness spread
	const float Traffic = Masks.r;
	float R = lerp(0.40, 0.68, Traffic) + (H - 0.5) * 0.12 + (MicroRough - 0.5) * 0.15 + 0.12 * (Film - 0.5) + 0.2 * saturate(Heel);
	C = lerp(C, C * 0.72 + GrimeTint * 0.28, Traffic * Age);
	// dried beer: darker, semi-gloss, sticky
	const float Sticky = saturate(Masks.g * StickyAmount * 1.4);
	C = lerp(C, C * 0.62 + float3(0.02, 0.012, 0.004), Sticky);
	R = lerp(R, 0.40, Sticky);
	// fresh puddles: mirror-like
	const float Spill = saturate(Masks.b);
	C = lerp(C, C * 0.55, Spill);
	R = lerp(R, 0.04, Spill);
	// blue chalk dust around the table
	const float Chalk = saturate(Masks.a * (0.6 + 0.8 * Chips));
	C = lerp(C, ChalkColor, 0.35 * Chalk);    // a dusting trodden into the wax: grey-blue, never the cube's saturated blue
	R = lerp(R, 0.8, Chalk * 0.6);
	OutRoughness = saturate(R);
	return saturate(C);
}

// ---- vinyl (booths, stools, armrest): cracks at high convexity, age-dependent ------------------------------------------
float RbVVinylCracks(float2 P, float Conv, float Age, float Amount, float ScaleM, float Footprint)
{
	// cellular cracks: distance to the nearest cell border of a jittered grid
	const float2 Q = P / ScaleM;
	const float2 I = floor(Q);
	const float2 F = Q - I;
	float D1 = 8.0;
	float D2 = 8.0;
	for (int Y = -1; Y <= 1; ++Y)
	{
		for (int X = -1; X <= 1; ++X)
		{
			const int2 C = int2(I) + int2(X, Y);
			const float2 O = float2(X, Y) + RbVHash22(C);
			const float Dd = length(O - F);
			if (Dd < D1) { D2 = D1; D1 = Dd; } else if (Dd < D2) { D2 = Dd; }
		}
	}
	const float Border = D2 - D1;
	const float W = 0.06 + 0.1 * RbVOctave(1.0 / ScaleM, Footprint);
	const float Crack = 1.0 - smoothstep(0.0, W, Border);
	const float Where = saturate(Age * Amount * (0.35 + 1.4 * Conv));
	return Crack * Where * RbVOctave(2.0 / ScaleM, Footprint);
}

// ---- metals (chrome pitting, brass patina, fingerprints) ----------------------------------------------------------------
// Returns (F0 multiplier, roughness add, patina / rust coverage). P in metres.
float3 RbVMetalAge(float3 P, float AO, float Conv, float Age, float Pitting, float PatinaAmount, float Fingerprint, float Footprint)
{
	const float Pits = step(0.83, RbVNoise3(P * 900.0)) * RbVOctave(900.0, Footprint) * Pitting * Age;
	const float Blotch = RbVFbm3(P * 18.0, 3, Footprint * 18.0);
	const float Patina = saturate(PatinaAmount * Age * (pow(saturate(1.0 - AO), 1.2) * 1.6 + 0.25 * Blotch));
	const float F0Mult = 1.0 - 0.6 * Pits - 0.25 * Patina;
	const float RoughAdd = 0.35 * Pits + 0.18 * Fingerprint + 0.08 * Blotch * Age;
	return float3(F0Mult, RoughAdd, Patina);
}

// ---- emissive (neon, panels, screens): luminance in cd/m^2 x the venue's calibrated scale, optional slow colour cycle ----
// CyclePeriod > 0 cycles smoothly A -> B -> C (period >= 4 s, never a flash: venue-dive-bar 4.1, L18).
float3 RbVEmissive(float3 ColorA, float3 ColorB, float3 ColorC, float Luminance, float Scale, float CyclePeriod, float Time, float3 TexColor)
{
	float3 Col = ColorA;
	if (CyclePeriod > 0.0)
	{
		const float Period = max(CyclePeriod, 4.0);
		const float Ph = frac(Time / Period) * 3.0;
		const float S = smoothstep(0.0, 1.0, frac(Ph));
		Col = Ph < 1.0 ? lerp(ColorA, ColorB, S) : (Ph < 2.0 ? lerp(ColorB, ColorC, S) : lerp(ColorC, ColorA, S));
	}
	return Col * TexColor * Luminance * Scale;
}
