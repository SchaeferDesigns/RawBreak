// RAW BREAK - analytic pool-ball surface (ue5-realism-plan 6.2, 4.6; Docs/ue-architecture.md 8.3).
// Included from the Custom node of M_RbBall (generated by Tools/unreal/editor/rb_make_materials.py).
// All inputs are in BALL-LOCAL coordinates of the unit sphere (object-space position / radius), so the decal
// layout has no UV seams, no pole pinching and is resolution independent.
//
// Layout (WPA ball set): number circles centred on the local +X / -X poles (one upside down), stripe band
// |z_local| < sin(StripeHalfAngle) for balls 9-15, glyphs from a 4x4 atlas via gnomonic projection.
// Rotation smear (anti wagon-wheel, 4.6): blend the albedo toward its band average by
//   alpha = saturate(|w| * ExposureTime / (2 pi)).
//
// TODO(UE-3): implement RbBallAlbedo (base colour, stripe, number circle, glyph lookup, rotation smear).

#pragma once

// P: unit-sphere local position; BallNumber 0..15; BaseColor: linear colour of the ball's number;
// OmegaLocal: angular velocity in ball-local axes [rad/s]; ExposureTime [s]. Returns linear albedo.
float3 RbBallAlbedo(float3 P, float BallNumber, float3 BaseColor, float3 OmegaLocal, float ExposureTime,
	float StripeHalfAngle, float CircleHalfAngle)
{
	// TODO(UE-3): placeholder - solid colour, white cue ball.
	return BallNumber < 0.5 ? float3(0.78, 0.77, 0.74) : BaseColor;
}
