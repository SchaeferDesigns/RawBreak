// RAW BREAK - analytic pool-ball surface (ue5-realism-plan 6.2, 4.6; Docs/ue-architecture.md 8.2).
// Included from the Custom node of M_RbBall (generated by Tools/unreal/editor/rb_make_materials.py).
// All inputs are in BALL-LOCAL coordinates of the unit sphere (object-space position of SM_RbBall, radius 1 cm), so the
// decal layout has no UV seams, no pole pinching and is resolution independent. The local position comes from the
// material's LocalPosition node (absolute world position x world-to-instance), which is valid in ray-tracing hit shaders
// too: the numbers also appear in the hit-lit Lumen reflections of the other balls.
//
// Layout (WPA ball set, plan 6.2):
//  * solids 1-8: ball colour; stripes 9-15: white ball with a centred band |z_local| < sin(StripeHalfAngle) of the colour
//    of number - 8; cue ball 0: white, optionally six generic red dots on the local axes (spin readability, plan 6.2).
//  * number circles (white) centred on the local +X / -X poles, angular radius CircleHalfAngle; they sit on the band's
//    centre line of the stripes. Each number is printed twice: upright at +X (glyph up = local +Z), upside down at -X.
//  * glyphs: 4 x 4 signed-distance atlas T_RbBallGlyphs (cell n = the label of ball n, 6 and 9 underscored, inscribed in
//    the circle), sampled through the gnomonic projection of the pole's tangent plane (great circles -> straight lines,
//    the circle maps to the inscribed disc of the cell).
//  * edges (band, circle, glyph, dots) are anti-aliased from screen derivatives; ray tracing has none (RbCommon.ush), so a
//    fixed minimum width applies there.
// Rotation smear (anti wagon-wheel, plan 4.6): the albedo is blended toward its EXACT average over the circle the surface
// point travels around the spin axis, alpha = saturate(|w| * ExposureTime / (2 pi)). The average is analytic: the
// fraction of that circle inside the band / circles / dots follows from acos (RbRingFraction), so a fast striped ball
// renders as its band-averaged colour without a pre-filtered texture.

#pragma once

#include "/RawBreak/Private/RbCommon.ush"

// Colours that are not per-ball parameters (linear, ESTIMATE; plan 6.2 / colour-checker measurements pending).
static const float3 RbBallInkColor = float3(0.012, 0.012, 0.013);
static const float3 RbCueDotColor = float3(0.52, 0.025, 0.028);
static const float RbCueDotHalfAngleDeg = 7.0;   // ~7 mm dots on a 57.15 mm ball

// Minimum filter widths where no screen derivatives exist (ray tracing): angles [rad] and glyph SDF units.
static const float RbBallMinAngleWidth = 0.004;
static const float RbBallMinSdfWidth = 0.05;

// Fraction of the circle Mean + Amp cos(theta), theta in [0, 2 pi), whose value lies in (Lo, Hi).
float RbRingFraction(float Mean, float Amp, float Lo, float Hi)
{
	if (Amp < 1e-5)
	{
		return (Mean > Lo && Mean < Hi) ? 1.0 : 0.0;
	}
	const float A = acos(clamp((Lo - Mean) / Amp, -1.0, 1.0));
	const float B = acos(clamp((Hi - Mean) / Amp, -1.0, 1.0));
	return (A - B) / RB_PI;
}

// Mean and amplitude of the local coordinate Axis_k (k-th unit vector) along the rotation circle of N about SpinAxis.
float2 RbRingComponent(float3 N, float3 SpinAxis, int K)
{
	const float C = dot(N, SpinAxis);
	const float R = sqrt(saturate(1.0 - C * C));
	const float Ak = SpinAxis[K];
	return float2(C * Ak, R * sqrt(saturate(1.0 - Ak * Ak)));
}

// Share of a number circle covered by ink, per label (for the rotation smear). Measured on T_RbBallGlyphs by
// rb_make_materials.py, which fails when the atlas and this table drift apart by more than 0.01.
static const float RbInkShareTable[16] = {
	0.000, 0.066, 0.102, 0.102, 0.107, 0.110, 0.134, 0.080, 0.125, 0.133, 0.147, 0.108, 0.133, 0.132, 0.136, 0.135
};

float RbInkShare(int Number)
{
	return RbInkShareTable[clamp(Number, 0, 15)];
}

// Exact average albedo over the rotation circle of N about SpinAxis (unit).
float3 RbBallRingAverage(float3 N, float3 SpinAxis, int Number, float3 BaseColor, float3 White, float SinBand, float CosCircle,
	float CueBallDots)
{
	const float2 X = RbRingComponent(N, SpinAxis, 0);
	const float2 Y = RbRingComponent(N, SpinAxis, 1);
	const float2 Z = RbRingComponent(N, SpinAxis, 2);
	if (Number == 0)
	{
		const float CosDot = cos(radians(RbCueDotHalfAngleDeg));
		float Dots = 0.0;
		Dots += RbRingFraction(X.x, X.y, CosDot, 2.0) + RbRingFraction(X.x, X.y, -2.0, -CosDot);
		Dots += RbRingFraction(Y.x, Y.y, CosDot, 2.0) + RbRingFraction(Y.x, Y.y, -2.0, -CosDot);
		Dots += RbRingFraction(Z.x, Z.y, CosDot, 2.0) + RbRingFraction(Z.x, Z.y, -2.0, -CosDot);
		Dots *= CueBallDots > 0.5 ? 1.0 : 0.0;
		return lerp(White, RbCueDotColor, saturate(Dots));
	}
	const float Disc = saturate(RbRingFraction(X.x, X.y, CosCircle, 2.0) + RbRingFraction(X.x, X.y, -2.0, -CosCircle));
	const float3 DiscColor = lerp(White, RbBallInkColor, RbInkShare(Number));
	if (Number >= 9)
	{
		// The circles lie inside the band (CircleHalfAngle < StripeHalfAngle): band share without the circles.
		const float Band = max(RbRingFraction(Z.x, Z.y, -SinBand, SinBand), Disc);
		return Disc * DiscColor + (Band - Disc) * BaseColor + (1.0 - Band) * White;
	}
	return Disc * DiscColor + (1.0 - Disc) * BaseColor;
}

// P: ball-local position (any radius); BallNumber 0..15; BaseColor: linear colour of the ball's number (the band colour
// of a stripe); White: the ball white (cue ball, stripe ground, number circles); OmegaLocal: angular velocity in
// ball-local axes [rad/s]; ExposureTime [s]; half angles in degrees; CueBallDots > 0.5 = dotted cue ball.
// Returns the linear diffuse albedo.
float3 RbBallAlbedo(float3 P, float BallNumber, float3 BaseColor, float3 White, float3 OmegaLocal, float ExposureTime,
	float StripeHalfAngleDeg, float CircleHalfAngleDeg, float CueBallDots, Texture2D GlyphAtlas, SamplerState GlyphAtlasSampler)
{
	const float3 N = normalize(P);
	const int Number = clamp((int)round(BallNumber), 0, 15);
	const float StripeHalf = radians(StripeHalfAngleDeg);
	const float CircleHalf = radians(CircleHalfAngleDeg);

	// Signed distances (positive inside) and their screen-space widths - evaluated unconditionally (derivatives must not
	// sit in divergent control flow).
	const float BandSD = StripeHalf - asin(saturate(abs(N.z)));
	const float CircleSD = CircleHalf - acos(saturate(abs(N.x)));
	const float3 A = abs(N);
	const float DotSD = radians(RbCueDotHalfAngleDeg) - acos(saturate(max(A.x, max(A.y, A.z))));
	const float Band = RbAaStep(BandSD, fwidth(BandSD), RbBallMinAngleWidth);
	const float Circle = RbAaStep(CircleSD, fwidth(CircleSD), RbBallMinAngleWidth);
	const float Dot = RbAaStep(DotSD, fwidth(DotSD), RbBallMinAngleWidth);

	// Glyph: gnomonic coordinates of the pole's tangent plane, scaled so the circle edge is the unit circle.
	// +X pole: seen from outside (looking along -X, local +Z up) screen-right is -Y. -X pole: the same label upside down.
	const float Side = N.x >= 0.0 ? 1.0 : -1.0;
	const float2 G = float2(-N.y, Side * N.z) / (max(abs(N.x), 1e-3) * tan(CircleHalf));
	const float2 CellUV = clamp(float2(0.5 + 0.5 * G.x, 0.5 - 0.5 * G.y), 0.004, 0.996);
	const float2 AtlasUV = (float2(Number % 4, Number / 4) + CellUV) * 0.25;
	const float GlyphSD = Texture2DSample(GlyphAtlas, GlyphAtlasSampler, AtlasUV).r - 0.5;
	const float Ink = RbAaStep(GlyphSD, fwidth(GlyphSD), RbBallMinSdfWidth) * Circle * (Number > 0 ? 1.0 : 0.0);

	// Composition: ground -> band -> circle -> ink (cue ball: white + optional dots).
	const float IsStripe = Number >= 9 ? 1.0 : 0.0;
	const float IsCue = Number == 0 ? 1.0 : 0.0;
	float3 Albedo = lerp(BaseColor, lerp(White, BaseColor, Band), IsStripe);
	Albedo = lerp(Albedo, White, Circle);
	Albedo = lerp(Albedo, RbBallInkColor, Ink);
	const float3 Cue = lerp(White, RbCueDotColor, Dot * (CueBallDots > 0.5 ? 1.0 : 0.0));
	Albedo = lerp(Albedo, Cue, IsCue);

	// Rotation smear toward the analytic ring average.
	const float Spin = length(OmegaLocal);
	const float Alpha = saturate(Spin * ExposureTime / RB_TWO_PI);
	if (Alpha > 1e-3)
	{
		const float3 Average = RbBallRingAverage(N, OmegaLocal / Spin, Number, BaseColor, White, sin(StripeHalf), cos(CircleHalf), CueBallDots);
		Albedo = lerp(Albedo, Average, Alpha);
	}
	return Albedo;
}

// ---- worn bar balls (M2-L; venue-dive-bar 3.2 / 6.4, plan 6.2 "worn bar balls") ----------------------------------------------

// Smooth 3D value noise in [-1, 1] (trilinear quintic of lattice hashes).
float RbValueNoise3(float3 P)
{
	const float3 I = floor(P);
	const float3 F = P - I;
	const float3 U = F * F * F * (F * (F * 6.0 - 15.0) + 10.0);
	const int3 C = int3(I);
	const float N000 = RbHash3(C);
	const float N100 = RbHash3(C + int3(1, 0, 0));
	const float N010 = RbHash3(C + int3(0, 1, 0));
	const float N110 = RbHash3(C + int3(1, 1, 0));
	const float N001 = RbHash3(C + int3(0, 0, 1));
	const float N101 = RbHash3(C + int3(1, 0, 1));
	const float N011 = RbHash3(C + int3(0, 1, 1));
	const float N111 = RbHash3(C + int3(1, 1, 1));
	const float X0 = lerp(lerp(N000, N100, U.x), lerp(N010, N110, U.x), U.y);
	const float X1 = lerp(lerp(N001, N101, U.x), lerp(N011, N111, U.x), U.y);
	return lerp(X0, X1, U.z) * 2.0 - 1.0;
}

// Per-ball wear on the unit sphere (P: ball-local position, any radius): grime (a greyish film, darker in patches), collision
// scuffs (small dull, lighter rings where balls hit each other), blue chalk marks (mostly on the cue ball), and a per-ball
// roughness from RoughnessMin .. RoughnessMax (seeded by the number; the 3 of a mismatched set too). Dirt / Chalk 0 = a clean set
// (M1: nothing changes). Returns the albedo; Roughness in / out.
float3 RbBallWear(float3 P, float BallNumber, float3 Albedo, float Dirt, float Chalk, float RoughnessMin, float RoughnessMax, inout float Roughness)
{
	const float3 N = normalize(P);
	const int Number = clamp((int)round(BallNumber), 0, 15);
	const float Seed = float(Number) * 7.31 + 1.7;
	const float PerBall = RbHash2(int2(Number, 911));
	Roughness = RoughnessMax > RoughnessMin ? lerp(RoughnessMin, RoughnessMax, PerBall) : Roughness;
	if (Dirt <= 0.0 && Chalk <= 0.0)
	{
		return Albedo;
	}
	// Grime: two octaves on the sphere (~8 mm and ~3 mm on a 57 mm ball), pulling toward a grey-brown film.
	const float G = 0.6 * RbValueNoise3(N * 4.0 + Seed) + 0.4 * RbValueNoise3(N * 11.0 - Seed);
	const float Film = Dirt * saturate(0.45 + 0.8 * G);
	const float3 Grime = float3(0.30, 0.27, 0.22) * (0.5 + 0.5 * RbLuminance(Albedo) / 0.5);
	float3 Out = lerp(Albedo, min(Albedo, Grime) * 0.9 + Albedo * 0.1, 0.35 * Film);
	Out *= 1.0 - 0.10 * Dirt * saturate(G);
	Roughness = saturate(Roughness + 0.05 * Film);
	// Collision scuffs: 10 seeded spots, each a thin ring ~3 mm across (1 unit = the ball radius, 28.6 mm).
	float Scuff = 0.0;
	for (int I = 0; I < 10; ++I)
	{
		const float3 H = float3(RbHash2(int2(Number, 31 * I + 1)), RbHash2(int2(Number, 31 * I + 2)), RbHash2(int2(Number, 31 * I + 3)));
		const float Z = H.x * 2.0 - 1.0;
		const float Phi = H.y * RB_TWO_PI;
		const float3 C = float3(sqrt(saturate(1.0 - Z * Z)) * cos(Phi), sqrt(saturate(1.0 - Z * Z)) * sin(Phi), Z);
		const float D = length(N - C);
		const float R = 0.045 + 0.05 * H.z;
		Scuff = max(Scuff, (1.0 - smoothstep(0.004, 0.012, abs(D - R))) * (0.5 + 0.5 * H.z) + 0.35 * (1.0 - smoothstep(0.0, R, D)));
	}
	Scuff *= Dirt;
	Out = lerp(Out, Out + 0.035 * (1.0 - RbLuminance(Out)), Scuff);
	Roughness = saturate(Roughness + 0.12 * Scuff);
	// Chalk: blue smudges; the cue ball carries most of them (tip contacts).
	const float ChalkShare = Chalk * (Number == 0 ? 1.0 : 0.25);
	const float Blot = saturate(RbValueNoise3(N * 6.0 + Seed * 3.0) * 2.2 - 0.9) * saturate(RbValueNoise3(N * 25.0) + 0.6);
	Out = lerp(Out, float3(0.20, 0.34, 0.60) * (0.4 + 0.6 * RbLuminance(Out) / 0.5), 0.6 * ChalkShare * Blot);
	Roughness = saturate(Roughness + 0.3 * ChalkShare * Blot);
	return Out;
}

// Mean free path of the resin [cm] for the slab's SSS (plan 6.2: 0.5-2 mm, light balls scatter further). MfpFraction is
// the MFP of a white ball relative to the ball radius.
float3 RbBallMfp(float3 Albedo, float BallRadiusCm, float MfpFraction)
{
	return BallRadiusCm * MfpFraction * (0.25 + 0.75 * saturate(Albedo));
}
